generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ CORE USER & ORG MODELS ============

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String
  role          String   // applicant, local_agency, international_agency, employer
  phone         String?
  avatar        String?
  isActive      Boolean  @default(true)
  isApproved    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  agencyMembers      AgencyMember[]
  employerProfile     EmployerProfile?
  applicantProfile    ApplicantProfile?
  applications         Application[]
  endorsementsAsEndorser Endorsement[] @relation("EndorserUser")
  notifications        Notification[]
  resumeEnhancements  ResumeEnhancement[]
  createdJobOrders    JobOrder[] @relation("CreatedByUser")

  @@index([email])
  @@index([role])
}

model Agency {
  id          String   @id @default(cuid())
  name        String
  agencyType  String   @default("local") // local or international
  address     String?
  city        String?
  country     String?
  licenseNo   String?
  phone       String?
  email       String?
  website     String?
  isActive    Boolean  @default(true)
  isApproved  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     AgencyMember[]
  jobOrders   JobOrder[]
}

model AgencyMember {
  id          String   @id @default(cuid())
  userId      String
  agencyId    String
  role        String   @default("member") // admin, recruiter, processor, deployment_officer, member
  joinedAt    DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
  agency      Agency   @relation(fields: [agencyId], references: [id])

  @@unique([userId, agencyId])
  @@index([agencyId])
}

model EmployerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  companyName     String
  companyAddress  String?
  country         String
  industry        String?
  contactPerson   String?
  contactEmail    String?
  contactPhone    String?
  website         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id])
  jobOrders       JobOrder[]
  endorsements    Endorsement[]
}

// ============ APPLICANT MODELS ============

model ApplicantProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  firstName       String
  middleName      String?
  lastName        String
  suffixName      String?
  gender          String?
  birthDate       DateTime?
  birthPlace      String?
  nationality     String   @default("Filipino")
  civilStatus     String?  // Single, Married, Widowed, Separated
  religion        String?
  height          String?  // in cm
  weight          String?  // in kg
  address         String?
  city            String?
  province        String?
  region          String?
  zipCode         String?
  phone           String?
  altPhone        String?
  email           String?
  // Applicant Type
  applicantType   String?  // domestic_helper, skills_professional
  // For Domestic Helpers
  householdTasks  String?  // JSON array of task categories
  // Passport & Travel
  passportNo      String?
  passportExpiry  DateTime?
  passportStatus  String?  // none, valid, expired, processing, renewal
  // Visa
  hasVisa         Boolean  @default(false)
  visaCountry     String?
  visaType        String?
  visaStatus      String?  // none, valid, expired, processing
  visaExpiry      DateTime?
  // Medical
  medicalStatus   String?  // none, scheduled, in_progress, passed, failed, expired
  medicalExpiry   DateTime?
  // Education & Career
  highestEducation String?  // elementary, high_school, college_vocational, bachelors, masters, doctorate
  yearsExperience Int?
  preferredCountry String?
  preferredJob    String?
  salaryExpectation String?
  availabilityDate String?  // when can they start
  resumeText      String?
  // Emergency Contact
  emergencyName   String?
  emergencyRelation String?
  emergencyPhone  String?
  // Form completion
  formStep        Int      @default(0)
  isComplete      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id])
  education       ApplicantEducation[]
  experience      ApplicantExperience[]
  skills          ApplicantSkill[]
  languages       ApplicantLanguage[]
  certifications  ApplicantCertification[]
  references      ApplicantReference[]
  documents       ApplicantDocument[]
  trainings       ApplicantTraining[]

  @@index([userId])
  @@index([applicantType])
}

model ApplicantEducation {
  id              String   @id @default(cuid())
  applicantId     String
  institution     String
  degree          String
  fieldOfStudy    String?
  startYear       Int
  endYear         Int
  honors          String?
  createdAt       DateTime @default(now())

  applicant       ApplicantProfile @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([applicantId])
}

model ApplicantExperience {
  id              String   @id @default(cuid())
  applicantId     String
  company         String
  position        String
  country         String?
  startDate       DateTime
  endDate         DateTime?
  isCurrent       Boolean  @default(false)
  description     String?
  monthlySalary   String?
  employerContact String?
  createdAt       DateTime @default(now())

  applicant       ApplicantProfile @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([applicantId])
}

model ApplicantSkill {
  id              String   @id @default(cuid())
  applicantId     String
  name            String
  level           String   @default("intermediate")
  yearsExperience Int?
  createdAt       DateTime @default(now())

  applicant       ApplicantProfile @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([applicantId])
}

model ApplicantLanguage {
  id              String   @id @default(cuid())
  applicantId     String
  language        String
  proficiency     String   @default("conversational") // basic, conversational, intermediate, advanced, fluent, native
  speaking        String?  // basic, intermediate, advanced, fluent, native
  reading         String?  // basic, intermediate, advanced, fluent, native
  writing         String?  // basic, intermediate, advanced, fluent, native
  createdAt       DateTime @default(now())

  applicant       ApplicantProfile @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([applicantId])
}

model ApplicantCertification {
  id              String   @id @default(cuid())
  applicantId     String
  name            String
  issuingBody     String?
  issuedDate      DateTime?
  expiryDate      DateTime?
  credentialId    String?
  createdAt       DateTime @default(now())

  applicant       ApplicantProfile @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([applicantId])
}

model ApplicantReference {
  id              String   @id @default(cuid())
  applicantId     String
  name            String
  company         String?
  position        String?
  phone           String?
  email           String?
  relationship    String?
  yearsKnown      String?
  createdAt       DateTime @default(now())

  applicant       ApplicantProfile @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([applicantId])
}

model ApplicantDocument {
  id              String   @id @default(cuid())
  applicantId     String
  documentType    String   // nso_birth_cert, valid_id, nbi_clearance, passport, medical_cert, etc.
  fileName        String
  filePath        String?
  fileSize        Int?
  mimeType        String?
  isVerified      Boolean  @default(false)
  uploadedAt      DateTime @default(now())

  applicant       ApplicantProfile @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([applicantId])
}

model ApplicantTraining {
  id              String   @id @default(cuid())
  applicantId     String
  trainingName    String
  institution     String?
  startDate       DateTime?
  endDate         DateTime?
  hours           Int?
  createdAt       DateTime @default(now())

  applicant       ApplicantProfile @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([applicantId])
}

// ============ JOB & ATS MODELS ============

model JobOrder {
  id              String   @id @default(cuid())
  title           String
  description     String
  country         String
  city            String?
  category        String   // domestic_helper, caregiver, nurse, engineer, factory, hospitality, etc.
  jobType         String?  // domestic_helper or skills_professional (set by FIRA/international)
  salaryMin       Float?
  salaryMax       Float?
  salaryCurrency  String   @default("USD")
  salaryPeriod    String?  // monthly, weekly, daily, hourly
  contractType    String   @default("full_time")
  duration        String?
  slots           Int      @default(1)
  filledSlots     Int      @default(0)
  requirements    String
  benefits        String?
  requiredSkills  String
  status          String   @default("open") // open, closed, filled, cancelled
  visibility      String   @default("public") // public, agency_only, private
  employerId      String?
  agencyId        String?
  createdBy       String?  // who created this job order
  postedDate      DateTime @default(now())
  deadline        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employer        EmployerProfile? @relation(fields: [employerId], references: [id])
  agency          Agency?          @relation(fields: [agencyId], references: [id])
  createdByUser   User?            @relation("CreatedByUser", fields: [createdBy], references: [id])
  applications    Application[]
  atsStages       ATSStage[]
  customFields    JobCustomField[]

  @@index([status])
  @@index([visibility])
  @@index([country])
  @@index([category])
  @@index([employerId])
  @@index([agencyId])
}

model JobCustomField {
  id              String   @id @default(cuid())
  jobOrderId      String
  label           String
  fieldType       String   @default("text") // text, textarea, select, multiselect, checkbox, date, number, file
  options         String?  // JSON array for select/multiselect
  isRequired      Boolean  @default(false)
  order           Int      @default(0)
  createdAt       DateTime @default(now())

  jobOrder        JobOrder @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)

  @@index([jobOrderId])
}

model Application {
  id              String   @id @default(cuid())
  applicantId     String
  jobOrderId      String
  status          String   @default("applied") // applied, screening, shortlisted, interview, offered, hired, rejected, withdrawn, deployed
  coverLetter     String?
  matchScore      Float?
  currentStageId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  applicant       User     @relation(fields: [applicantId], references: [id])
  jobOrder        JobOrder @relation(fields: [jobOrderId], references: [id])
  currentStage    ATSStage? @relation(fields: [currentStageId], references: [id])
  atsHistory      ATSStageHistory[]
  endorsements    Endorsement[]
  aiAnalysis      AIAnalysisResult?
  customResponses ApplicationCustomResponse[]

  @@unique([applicantId, jobOrderId])
  @@index([applicantId])
  @@index([jobOrderId])
  @@index([status])
}

model ApplicationCustomResponse {
  id              String   @id @default(cuid())
  applicationId   String
  fieldId         String
  value           String?
  createdAt       DateTime @default(now())

  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model ATSStage {
  id              String   @id @default(cuid())
  jobOrderId      String
  name            String
  order           Int
  color           String   @default("#10b981")
  isDefault       Boolean  @default(true)
  createdAt       DateTime @default(now())

  jobOrder        JobOrder    @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)
  applications    Application[]
  history         ATSStageHistory[]

  @@unique([jobOrderId, order])
  @@index([jobOrderId])
}

model ATSStageHistory {
  id              String   @id @default(cuid())
  applicationId   String
  stageId         String
  fromStageId     String?
  movedBy         String?
  notes           String?
  createdAt       DateTime @default(now())

  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stage           ATSStage    @relation(fields: [stageId], references: [id])

  @@index([applicationId])
  @@index([stageId])
}

// ============ ENDORSEMENT MODEL ============
// Flow: Local Agency → FIRA (International) → Employer

model Endorsement {
  id              String   @id @default(cuid())
  applicationId   String
  endorsedById    String
  employerId      String
  status          String   @default("pending_fira_review") // pending_fira_review, fira_approved, fira_rejected, pending_employer_review, employer_accepted, employer_declined
  coverNote       String?
  agencyNote      String?
  firaNote        String?
  employerNote    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  application     Application    @relation(fields: [applicationId], references: [id])
  endorser        User           @relation("EndorserUser", fields: [endorsedById], references: [id])
  employer        EmployerProfile @relation(fields: [employerId], references: [id])

  @@index([applicationId])
  @@index([employerId])
  @@index([status])
}

// ============ NOTIFICATION MODEL ============

model Notification {
  id              String   @id @default(cuid())
  userId          String
  title           String
  message         String
  type            String   @default("info") // info, success, warning, error
  isRead          Boolean  @default(false)
  link            String?
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

// ============ AI MODELS ============

model AIAnalysisResult {
  id              String   @id @default(cuid())
  applicationId   String   @unique
  matchScore      Float
  semanticScore   Float
  matchedSkills   String   // JSON array
  missingSkills   String   // JSON array
  explanation     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  application     Application @relation(fields: [applicationId], references: [id])

  @@index([applicationId])
}

model ResumeEnhancement {
  id              String   @id @default(cuid())
  applicantId     String
  jobOrderId      String?
  originalText    String
  enhancedText    String
  changesSummary  String
  isUsed          Boolean  @default(false)
  createdAt       DateTime @default(now())

  applicant       User     @relation(fields: [applicantId], references: [id])

  @@index([applicantId])
}
