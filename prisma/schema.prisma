generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============ CORE USER & ORG MODELS ============

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String
  role          String   // super_admin, admin, staff, applicant, local_agency, international_agency, employer
  phone         String?
  avatar        String?
  isActive      Boolean  @default(true)
  isApproved    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  agencyMembers      AgencyMember[]
  employerProfile     EmployerProfile?
  applicantProfile    ApplicantProfile?
  applications         Application[]
  endorsementsAsEndorser Endorsement[] @relation("EndorserUser")
  notifications        Notification[]
  resumeEnhancements  ResumeEnhancement[]
  createdJobOrders    JobOrder[] @relation("CreatedByUser")

  @@index([email])
  @@index([role])
}

model Agency {
  id          String   @id @default(cuid())
  name        String
  agencyType  String   @default("local") // local or international
  address     String?
  city        String?
  country     String?
  licenseNo   String?
  phone       String?
  email       String?
  website     String?
  isActive    Boolean  @default(true)
  isApproved  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     AgencyMember[]
  jobOrders   JobOrder[]
}

model AgencyMember {
  id          String   @id @default(cuid())
  userId      String
  agencyId    String
  role        String   @default("member") // admin, recruiter, processor, deployment_officer, member
  joinedAt    DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
  agency      Agency   @relation(fields: [agencyId], references: [id])

  @@unique([userId, agencyId])
  @@index([agencyId])
}

model EmployerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  companyName     String
  companyAddress  String?
  country         String
  industry        String?
  contactPerson   String?
  contactEmail    String?
  contactPhone    String?
  website         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id])
  jobOrders       JobOrder[]
  endorsements    Endorsement[]
}

// ============ APPLICANT MODELS ============

model ApplicantProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  firstName       String
  middleName      String?
  lastName        String
  suffixName      String?
  gender          String?
  birthDate       DateTime?
  birthPlace      String?
  nationality     String   @default("Filipino")
  civilStatus     String?
  religion        String?
  height          String?
  weight          String?
  address         String?
  city            String?
  province        String?
  region          String?
  zipCode         String?
  phone           String?
  altPhone        String?
  email           String?
  applicantType   String?  // domestic_helper, skills_professional
  householdTasks  String?
  passportNo      String?
  passportExpiry  DateTime?
  passportStatus  String?
  hasVisa         Boolean  @default(false)
  visaCountry     String?
  visaType        String?
  visaStatus      String?
  visaExpiry      DateTime?
  medicalStatus   String?
  medicalExpiry   DateTime?
  highestEducation String?
  yearsExperience Int?
  preferredCountry String?
  preferredJob    String?
  salaryExpectation String?
  availabilityDate String?
  resumeText      String?
  emergencyName   String?
  emergencyRelation String?
  emergencyPhone  String?
  formStep        Int      @default(0)
  isComplete      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id])
  education       ApplicantEducation[]
  experience      ApplicantExperience[]
  skills          ApplicantSkill[]
  languages       ApplicantLanguage[]
  certifications  ApplicantCertification[]
  references      ApplicantReference[]
  documents       ApplicantDocument[]
  trainings       ApplicantTraining[]

  @@index([userId])
  @@index([applicantType])
}

model ApplicantEducation {
  id              String   @id @default(cuid())
  applicantId     String
  institution     String
  degree          String
  fieldOfStudy    String?
  startYear       Int
  endYear         Int
  honors          String?
  createdAt       DateTime @default(now())

  applicant       ApplicantProfile @relation(fields: [applicantId], references: [id], onDelete: Cascade)
}

model ApplicantExperience {
  id              String   @id @default(cuid())
  applicantId     String
  company         String
  position        String
  country         String?
  startDate       DateTime
  endDate         DateTime?
  isCurrent       Boolean  @default(false)
  description     String?
  monthlySalary   String?
  employerContact String?
  createdAt       DateTime @default(now())

  applicant       ApplicantProfile @relation(fields: [applicantId], references: [id], onDelete: Cascade)
}

model ApplicantSkill {
  id              String   @id @default(cuid())
  applicantId     String
  name            String
  level           String   @default("intermediate")
  yearsExperience Int?
  createdAt       DateTime @default(now())

  applicant       ApplicantProfile @relation(fields: [applicantId], references: [id], onDelete: Cascade)
}

model ApplicantLanguage {
  id              String   @id @default(cuid())
  applicantId     String
  language        String
  proficiency     String   @default("conversational")
  speaking        String?
  reading         String?
  writing         String?
  createdAt       DateTime @default(now())

  applicant       ApplicantProfile @relation(fields: [applicantId], references: [id], onDelete: Cascade)
}

model ApplicantCertification {
  id              String   @id @default(cuid())
  applicantId     String
  name            String
  issuingBody     String?
  issuedDate      DateTime?
  expiryDate      DateTime?
  credentialId    String?
  createdAt       DateTime @default(now())

  applicant       ApplicantProfile @relation(fields: [applicantId], references: [id], onDelete: Cascade)
}

model ApplicantReference {
  id              String   @id @default(cuid())
  applicantId     String
  name            String
  company         String?
  position        String?
  phone           String?
  email           String?
  relationship    String?
  yearsKnown      String?
  createdAt       DateTime @default(now())

  applicant       ApplicantProfile @relation(fields: [applicantId], references: [id], onDelete: Cascade)
}

model ApplicantDocument {
  id              String   @id @default(cuid())
  applicantId     String
  documentType    String
  fileName        String
  filePath        String?
  fileSize        Int?
  mimeType        String?
  isVerified      Boolean  @default(false)
  uploadedAt      DateTime @default(now())

  applicant       ApplicantProfile @relation(fields: [applicantId], references: [id], onDelete: Cascade)
}

model ApplicantTraining {
  id              String   @id @default(cuid())
  applicantId     String
  trainingName    String
  institution     String?
  startDate       DateTime?
  endDate         DateTime?
  hours           Int?
  createdAt       DateTime @default(now())

  applicant       ApplicantProfile @relation(fields: [applicantId], references: [id], onDelete: Cascade)
}

// ============ JOB & ATS MODELS ============

model JobOrder {
  id              String   @id @default(cuid())
  title           String
  description     String
  country         String
  city            String?
  category        String
  jobType         String?
  salaryMin       Float?
  salaryMax       Float?
  salaryCurrency  String   @default("USD")
  salaryPeriod    String?
  contractType    String   @default("full_time")
  duration        String?
  slots           Int      @default(1)
  filledSlots     Int      @default(0)
  requirements    String
  benefits        String?
  requiredSkills  String
  status          String   @default("open")
  visibility      String   @default("public")
  employerId      String?
  agencyId        String?
  createdBy       String?
  postedDate      DateTime @default(now())
  deadline        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employer        EmployerProfile? @relation(fields: [employerId], references: [id])
  agency          Agency?          @relation(fields: [agencyId], references: [id])
  createdByUser   User?            @relation("CreatedByUser", fields: [createdBy], references: [id])
  applications    Application[]
  atsStages       ATSStage[]
  customFields    JobCustomField[]

  @@index([status])
  @@index([visibility])
  @@index([country])
  @@index([category])
}

model JobCustomField {
  id              String   @id @default(cuid())
  jobOrderId      String
  label           String
  fieldType       String   @default("text")
  options         String?
  isRequired      Boolean  @default(false)
  order           Int      @default(0)
  createdAt       DateTime @default(now())

  jobOrder        JobOrder @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)
}

model Application {
  id              String   @id @default(cuid())
  applicantId     String
  jobOrderId      String
  status          String   @default("applied")
  coverLetter     String?
  matchScore      Float?
  currentStageId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  applicant       User     @relation(fields: [applicantId], references: [id])
  jobOrder        JobOrder @relation(fields: [jobOrderId], references: [id])
  currentStage    ATSStage? @relation(fields: [currentStageId], references: [id])
  atsHistory      ATSStageHistory[]
  endorsements    Endorsement[]
  aiAnalysis      AIAnalysisResult?
  customResponses ApplicationCustomResponse[]

  @@unique([applicantId, jobOrderId])
}

model ApplicationCustomResponse {
  id              String   @id @default(cuid())
  applicationId   String
  fieldId         String
  value           String?
  createdAt       DateTime @default(now())

  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model ATSStage {
  id              String   @id @default(cuid())
  jobOrderId      String
  name            String
  order           Int
  color           String   @default("#10b981")
  isDefault       Boolean  @default(true)
  createdAt       DateTime @default(now())

  jobOrder        JobOrder    @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)
  applications    Application[]
  history         ATSStageHistory[]

  @@unique([jobOrderId, order])
}

model ATSStageHistory {
  id              String   @id @default(cuid())
  applicationId   String
  stageId         String
  fromStageId     String?
  movedBy         String?
  notes           String?
  createdAt       DateTime @default(now())

  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stage           ATSStage    @relation(fields: [stageId], references: [id])
}

// ============ ENDORSEMENT MODEL ============

model Endorsement {
  id              String   @id @default(cuid())
  applicationId   String
  endorsedById    String
  employerId      String
  status          String   @default("pending_fira_review")
  coverNote       String?
  agencyNote      String?
  firaNote        String?
  employerNote    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  application     Application    @relation(fields: [applicationId], references: [id])
  endorser        User           @relation("EndorserUser", fields: [endorsedById], references: [id])
  employer        EmployerProfile @relation(fields: [employerId], references: [id])
}

// ============ NOTIFICATION MODEL ============

model Notification {
  id              String   @id @default(cuid())
  userId          String
  title           String
  message         String
  type            String   @default("info")
  isRead          Boolean  @default(false)
  link            String?
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ AI MODELS ============

model AIAnalysisResult {
  id              String   @id @default(cuid())
  applicationId   String   @unique
  matchScore      Float
  semanticScore   Float
  matchedSkills   String
  missingSkills   String
  explanation     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  application     Application @relation(fields: [applicationId], references: [id])
}

model ResumeEnhancement {
  id              String   @id @default(cuid())
  applicantId     String
  jobOrderId      String?
  originalText    String
  enhancedText    String
  changesSummary  String
  isUsed          Boolean  @default(false)
  createdAt       DateTime @default(now())

  applicant       User     @relation(fields: [applicantId], references: [id])
}

// ============ CMS MODELS ============

model CmsPage {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String   @default("")
  status      String   @default("published") // draft, published
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CmsFaq {
  id          String   @id @default(cuid())
  question    String
  answer      String
  category    String   @default("General")
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CmsTestimonial {
  id          String   @id @default(cuid())
  name        String
  position    String?
  company     String?
  feedback    String
  rating      Int      @default(5)
  avatar      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CmsSocialMedia {
  id          String   @id @default(cuid())
  platform    String   // facebook, twitter, instagram, linkedin, whatsapp, tiktok, youtube
  title       String?
  url         String
  icon        String?  // SVG or icon name
  logo        String?  // uploaded logo path
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CmsOrgChart {
  id          String   @id @default(cuid())
  name        String
  position    String
  department  String?
  parentId    String?
  avatar      String?
  email       String?
  phone       String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CmsTermsPrivacy {
  id          String   @id @default(cuid())
  type        String   @unique // terms_of_service, data_privacy_consent
  title       String
  content     String
  version     String   @default("1.0")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CmsFormField {
  id          String   @id @default(cuid())
  label       String
  fieldType   String   @default("text") // text, textarea, select, multiselect, checkbox, date, number, file, email, phone
  options     String?  // JSON array for select/multiselect
  isRequired  Boolean  @default(false)
  order       Int      @default(0)
  section     String   @default("Personal Information")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CmsSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @default("")
  updatedAt   DateTime @updatedAt
}

model VerificationCode {
  id          String   @id @default(cuid())
  userId      String
  code        String
  type        String   @default("email_verification") // email_verification, password_reset
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())
}
