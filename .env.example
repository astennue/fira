# ============================================
# FIRA - Fil International Recruitment Agency
# Environment Variables Setup
# ============================================
# Copy this file as .env and fill in your credentials.
#
# ⚠️  IMPORTANT — two database modes:
#
#   [A] PRODUCTION PARITY (recommended default)
#       prisma/schema.prisma uses the "postgresql" provider.
#       Paste the Supabase connection strings below.
#       Get them from: https://supabase.com/dashboard → Project → Connect
#
#   [B] OFFLINE SQLITE DEV (no Supabase needed)
#       Run:  npm run db:dev:switch   (swaps in prisma/schema.sqlite.prisma)
#             npm run db:dev:setup   (generate + push + seed demo data)
#       .env:  DATABASE_URL="file:./prisma/dev.db"
#
# Note: a real DATABASE_URL already present in the shell environment
# takes precedence over this file (Next.js behavior).

# ── SUPABASE POSTGRES (mode A) ─────────────────────────────
# DATABASE_URL (pooled / pgbouncer — for Prisma app queries):
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[POOLER_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# DIRECT_URL (session pooler or direct — for Prisma migrations/seed):
DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[POOLER_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# ── SQLITE (mode B) ────────────────────────────────────────
# DATABASE_URL="file:./prisma/dev.db"
