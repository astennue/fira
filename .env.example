# ============================================
# FIRA - Fil International Recruitment Agency
# Environment Variables Setup
# ============================================
# Copy this file as .env.local and fill in your credentials

# SUPABASE DATABASE (Required for Vercel Production)
# Get these from: https://supabase.com/dashboard → Your Project → Settings → Database
#
# DATABASE_URL (connection pooling - for Prisma queries):
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[POOLER_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
#
# DIRECT_URL (direct connection - for Prisma migrations/seed):
DIRECT_URL=postgresql://postgres:[DB_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
