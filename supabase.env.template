# ============================================
# FIRA — Supabase Production Connection
# Copy this file as .env.local and fill in values from:
# https://supabase.com/dashboard → Your Project → Settings → Database
# ============================================
# NOTE: Do NOT commit the filled file (.env* is gitignored).

# DATABASE_URL — connection pooling (for Prisma queries, Vercel runtime):
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[POOLER_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# DIRECT_URL — direct connection (for Prisma migrations/seed):
DIRECT_URL=postgresql://postgres:[DB_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# ---------- How to get each value ----------
# [PROJECT_REF]    → Dashboard URL: https://supabase.com/dashboard/project/<PROJECT_REF>
# [REGION]         → Settings → Database → Connection info (e.g. ap-southeast-1)
# [POOLER_PASSWORD]→ The DB password you set at project creation (reset via Settings → Database → Reset password if forgotten)
# [DB_PASSWORD]    → Same password as above
#
# ---------- After filling in ----------
# 1. Switch prisma/schema.prisma provider: sqlite → postgresql
# 2. Run: npx prisma migrate diff --from-schema-datasource postgresql --to-schema-datamodel prisma/schema.prisma --script > supabase-init.sql
#    (or re-run supabase-migration.sql pieces in the Supabase SQL Editor)
# 3. Seed: update prisma/seed-supabase.js connection, then run it
# 4. Verify 7 users intact: SELECT email, role FROM "User";
